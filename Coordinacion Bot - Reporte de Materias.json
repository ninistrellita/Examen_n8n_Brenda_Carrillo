    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst counts = {};\nfor (const item of items) {\n  const materia = (item.json.materia || 'Sin materia').toString().trim() || 'Sin materia';\n  counts[materia] = (counts[materia] || 0) + 1;\n}\nconst rows = Object.entries(counts)\n  .sort((a, b) => b[1] - a[1])\n  .map(([materia, count]) => ({ materia, count }));\nreturn rows.map(r => ({ json: r }));"
      },
      "id": "6cf627e1-6ef2-4054-9849-cf0d72914e11",
      "name": "Contar por materia",
      "type": "n8n-nodes-base.code",
