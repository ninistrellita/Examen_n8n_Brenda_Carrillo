      "position": [
        1584,
        192
      ]
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst fecha = new Date().toLocaleString('es-CO', { timeZone: 'America/Bogota' });\nconst lineas = items.map(i => `\\u2022 <b>${i.json.materia}</b>: ${i.json.count}`).join('\\n');\nconst total = items.reduce((acc, i) => acc + (i.json.count || 0), 0);\nconst text = `\\uD83D\\uDCCA <b>Reporte de tutor\\u00edas por materia</b>\\n<i>Generado: ${fecha}</i>\\n\\n${lineas || 'Sin datos'}\\n\\n<b>Total: ${total}</b>`;\nreturn [{ json: { text, total, fecha } }];"
      },
